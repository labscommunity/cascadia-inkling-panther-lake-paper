# Fleet layout for the Inkling installation; every box's installer reads this file from the SSD.
# Rank r listens on RELAY_PORT+r and sends to rank r+1; rank 0 serves the OpenAI-compatible API on
# port 8000 (and the dashboard).
TOTAL=11
RELAY_PORT=9100
# How the ranks find each other.
# DISCOVER=1: a small beacon on every box announces its rank on the LAN and keeps the names
#   inkling-rank-<n> current in /etc/hosts, so addresses may come from DHCP and may change; the
#   installer never touches the network. All boxes must be on one LAN segment (one switch).
# DISCOVER=0: fixed addresses from the IP_<rank> lines below (the installer adds the address to the
#   wired port unless the box already has it or the install runs with --no-net).
DISCOVER=1
FLEET=inkling
BEACON_PORT=9099
# Only read with DISCOVER=0:
IP_0=REDACTED_IP
IP_1=REDACTED_IP
IP_2=REDACTED_IP
IP_3=REDACTED_IP
IP_4=REDACTED_IP
IP_5=REDACTED_IP
IP_6=REDACTED_IP
IP_7=REDACTED_IP
IP_8=REDACTED_IP
IP_9=REDACTED_IP
IP_10=REDACTED_IP
# Concurrent streams per rank (identical on every rank) and the context budget.
STREAMS=16
MAX_SEQ=1024
# Fused MoE layers the iGPU takes per box, at most (each is 8.3 GB of unified
# memory; the rest of the rank's layers stay on the CPU at 7.7 GB each). The
# iGPU can use half of RAM on both systems, so 3 on a 64 GB box, and the
# Ubuntu installer caps this by the box's RAM anyway. With 11 boxes every rank holds
# 6 layers: 3 on the iGPU + 3 on the CPU is about 48 GB of a 64 GB box. If
# status.sh shows a box swapping, lower this and re-run the installer there.
FUSED_LAYERS_LINUX=3
FUSED_LAYERS_WINDOWS=3
